    <string name="tutorial_tools_2_title">[19] TRADE_PLANNER</string>
    <string name="tutorial_tools_2_message">Compute entry, stop-loss, take-profit with custom R:R ratio. Visual preview.</string>

    <string name="tutorial_tools_3_title">[20] MTF_ANALYZER</string>
    <string name="tutorial_tools_3_message">Multi-Timeframe Analysis. Check bias on 1H, 4H, Daily for confluence.</string>

    <string name="tutorial_tools_4_title">[21] BACKTESTER</string>
    <string name="tutorial_tools_4_message">Test trading strategies on historical data. Win rate, drawdown, profit factor.</string>

    <string name="tutorial_tools_5_title">[22] PSYCHOLOGY_COACH</string>
    <string name="tutorial_tools_5_message">Locks the app when you trade emotionally. FOMO and revenge-trading detector.</string>

    <string name="tutorial_tools_6_title">[23] WHALE_TRACKER</string>
    <string name="tutorial_tools_6_message">Filter whale movements by chain, value, exchange. Set custom alerts.</string>

    <string name="tutorial_tools_7_title">[24] ENTRY_ANALYZER</string>
    <string name="tutorial_tools_7_message">Evaluate quality of a planned entry. Confluence score from 0 to 100.</string>

    <string name="tutorial_tools_8_title">[25] CORRELATION_MATRIX</string>
    <string name="tutorial_tools_8_message">See which coins move together. Critical for portfolio diversification.</string>

