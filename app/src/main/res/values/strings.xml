    <string name="tutorial_dash_6_message">Gas fees, mempool congestion, validator status. Critical for transaction timing.</string>

    <string name="tutorial_dash_7_title">[07] NAVIGATION_DRAWER</string>
    <string name="tutorial_dash_7_message">Access all 30+ modules from here. Swipe right from screen edge or tap menu icon.</string>

