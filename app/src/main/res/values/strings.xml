    <string name="tutorial_mkt_1_title">[09] GLOBAL_STATS</string>
    <string name="tutorial_mkt_1_message">Total market cap, BTC dominance, 24h volume. The big picture in one row.</string>

    <string name="tutorial_mkt_2_title">[10] COIN_LIST</string>
    <string name="tutorial_mkt_2_message">200+ assets ranked by market cap. Live price + 24h change + sparkline.</string>

    <string name="tutorial_mkt_3_title">[11] SORT_AND_FILTER</string>
    <string name="tutorial_mkt_3_message">Sort by gain, volume, or volatility. Filter by category (DeFi, L1, Meme, etc.).</string>

    <string name="tutorial_mkt_4_title">[12] FAVORITES</string>
    <string name="tutorial_mkt_4_message">Star coins for quick access. Watchlist syncs to Dashboard and Alerts.</string>

