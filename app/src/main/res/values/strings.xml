    <string name="tutorial_dash_1_title">[01] PRICE_TICKER</string>
    <string name="tutorial_dash_1_message">Live price feed for your watched assets. Tap any to dive into Analysis.</string>

    <string name="tutorial_dash_2_title">[02] AI_MARKET_NARRATIVE</string>
    <string name="tutorial_dash_2_message">Synthesized strategic report from 6 AI agents. Refreshes every 5 minutes.</string>

    <string name="tutorial_dash_3_title">[03] TOP_MOVERS</string>
    <string name="tutorial_dash_3_message">Real-time gainers and losers across 200+ tracked coins. Sortable by % or volume.</string>

    <string name="tutorial_dash_4_title">[04] WHALE_FEED</string>
    <string name="tutorial_dash_4_message">Live $500k+ transactions on BTC, ETH, and SOL chains. Direct from blockchain.</string>

    <string name="tutorial_dash_5_title">[05] SENTIMENT_PULSE</string>
