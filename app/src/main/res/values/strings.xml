    <string name="tutorial_ana_2_message">RSI, MACD, EMA 50/200, Bollinger Bands. Live values with bias interpretation.</string>

    <string name="tutorial_ana_3_title">[15] AI_VERDICT</string>
    <string name="tutorial_ana_3_message">Gemini-powered strategic conclusion. Confidence score and rationale included.</string>

    <string name="tutorial_ana_4_title">[16] PREDICTION_ENSEMBLE</string>
    <string name="tutorial_ana_4_message">6 forecasting engines: FFT, Monte Carlo, Wyckoff, Elliott, Hurst, Linear.</string>

    <string name="tutorial_ana_5_title">[17] DEEP_SCAN</string>
    <string name="tutorial_ana_5_message">Premium feature: detailed pattern recognition across multiple timeframes.</string>

